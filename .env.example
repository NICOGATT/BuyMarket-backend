# Plantilla de variables. NUNCA subas valores reales a git.
# Copiala a .env y completa los valores.

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=buymarket
# Sincronizacion automatica del esquema. Default: false.
# En produccion SIEMPRE es false (ignora el valor): usar migraciones
# (npm run migration:run). En desarrollo se habilita explicitamente con true.
DB_SYNCHRONIZE=true

JWT_SECRET=

MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=

BACKEND_URL=https://api.example.com
CORS_ORIGINS=
FRONTEND_SUCCESS_URL=
FRONTEND_FAILURE_URL=
FRONTEND_PENDING_URL=

TRANSFER_ALIAS=
TRANSFER_CBU=

RESEND_API_KEY=
MAIL_FROM=
GOOGLE_CLIENT_ID=

NODE_ENV=development

# --- Getnet Web Checkout Global ---
# UAT: https://api.pre.globalgetnet.com | Produccion: URL entregada por Getnet (distinta)
GETNET_API_URL=https://api.pre.globalgetnet.com
# UAT: https://www.pre.globalgetnet.com | Produccion: URL entregada por Getnet (distinta)
GETNET_WEB_URL=https://www.pre.globalgetnet.com
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
# Ruta configurable por si Getnet cambia la version del endpoint
GETNET_PAYMENT_INTENT_PATH=/digital-checkout/v1/payment-intent
# redirect (usa checkout_url) | iframe (usa loader.js + payment_intent_id)
GETNET_CHECKOUT_TYPE=redirect
# basic (default seguro) | none (solo UAT/local si Getnet no soporta Basic Auth)
GETNET_WEBHOOK_AUTH_MODE=basic
GETNET_WEBHOOK_USERNAME=
GETNET_WEBHOOK_PASSWORD=
# cents (default) | pesos: unidad del campo amount de Getnet; confirmar en homologacion
GETNET_AMOUNT_UNIT=cents
# URLs fijas configuradas TAMBIEN en el portal de Getnet (no se envian por operacion)
GETNET_SUCCESS_URL=
GETNET_ERROR_URL=
# Vencimiento del payment intent, formato de Getnet (ej: 1h, 30m)
GETNET_EXPIRES_AT=1h
# Timeout HTTP del cliente Getnet en ms (opcional, default 10000)
GETNET_TIMEOUT_MS=10000

# --- Getnet QR interoperable ---
GETNET_QR_ENABLED=false
GETNET_QR_API_URL=https://api.pre.globalgetnet.com
GETNET_QR_CLIENT_ID=
GETNET_QR_CLIENT_SECRET=
GETNET_QR_SELLER_ID=
GETNET_QR_CHANNEL=WEB
GETNET_QR_WEBHOOK_URL=
GETNET_QR_EXPIRATION_MINUTES=10

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
